# Web (apps/web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Worker ingest (repo root .env or apps/web/.env.local)
# From `supabase status -o env`: API_URL + SERVICE_ROLE_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended — free Tiingo Starter key for reliable daily OHLCV
# https://www.tiingo.com/ — if unset: Yahoo chart → Stooq CSV
TIINGO_API_KEY=

# Netlify scheduled ingest (site env, never NEXT_PUBLIC_*)
CRON_SECRET=

# Private agent API (JSON array, never NEXT_PUBLIC_*)
# [{"name":"chatgpt","secret":"long-random-token","role":"write"}]
POWERFUND_AGENT_API_KEYS=
