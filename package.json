{
  "name": "powerfund",
  "private": true,
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @powerfund/web dev",
    "dev:worker": "pnpm --filter @powerfund/worker dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "deploy": "netlify deploy --build --filter @powerfund/web",
    "deploy:prod": "netlify deploy --build --prod --filter @powerfund/web",
    "ingest:bars": "pnpm --filter @powerfund/worker ingest:bars",
    "ingest:fundamentals": "pnpm --filter @powerfund/worker ingest:fundamentals",
    "ingest:all": "pnpm --filter @powerfund/worker ingest:all",
    "smoke:market": "pnpm --filter @powerfund/worker smoke:market"
  },
  "dependencies": {
    "@netlify/functions": "^2.4.1"
  }
}
